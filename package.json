{
  "name": "anjos-de-resgate-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Monorepo da Plataforma Anjos de Resgate para prototipacao incremental.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:packages && pnpm --filter @anjos/api build && pnpm --filter @anjos/web build",
    "build:packages": "pnpm --filter @anjos/domain build && pnpm --filter @anjos/shared build && pnpm --filter @anjos/ui build",
    "dev": "pnpm run build:packages && concurrently \"pnpm --filter @anjos/api start:dev\" \"pnpm --filter @anjos/web dev\"",
    "dev:web": "pnpm --filter @anjos/web dev",
    "dev:api": "pnpm run build:packages && pnpm --filter @anjos/api start:dev",
    "pretest": "pnpm run build:packages",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @anjos/api db:generate",
    "db:generate:sqlite": "pnpm --filter @anjos/api db:generate:sqlite",
    "db:push": "pnpm --filter @anjos/api db:push",
    "db:push:sqlite": "pnpm --filter @anjos/api db:push:sqlite",
    "db:migrate:dev": "pnpm --filter @anjos/api db:migrate:dev",
    "db:migrate:dev:sqlite": "pnpm --filter @anjos/api db:migrate:dev:sqlite",
    "db:seed": "pnpm --filter @anjos/api db:seed",
    "docker:up": "sh scripts/docker-prototype.sh up",
    "docker:down": "sh scripts/docker-prototype.sh down",
    "docker:reset": "sh scripts/docker-prototype.sh reset",
    "docker:status": "sh scripts/docker-prototype.sh status",
    "docker:logs": "sh scripts/docker-prototype.sh logs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  }
}
