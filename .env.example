# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3333
API_INTERNAL_URL=http://localhost:3333
NEXT_PUBLIC_ADMIN_ACCESS_CODE=anjos2026

# Backend
PORT=3333
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=apps/api/uploads

# E-mail. No Docker, o Mailpit ja fornece SMTP local e caixa em localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Plataforma Anjos de Resgate <no-reply@anjos.local>
CONTACT_TO=contato@anjos.local
# SMTP_USER=
# SMTP_PASSWORD=

# Pix informativo. Substitua somente em ambiente autorizado pela ONG.
PIX_KEY=PIX-DEMONSTRACAO
PIX_RECIPIENT=Anjos de Resgate - ambiente de demonstracao

# PostgreSQL alvo arquitetural
DATABASE_URL=postgresql://anjos:anjos@localhost:5432/anjos_de_resgate?schema=public

# Alternativa local para prototipo com SQLite:
# DATABASE_URL=file:./dev.db

# Para demonstracao sem banco, habilite o repositorio em memoria:
# USE_IN_MEMORY_REPOSITORY=true
