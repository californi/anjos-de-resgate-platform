generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Animal {
  id             String             @id @default(uuid())
  name           String
  species        String
  sex            String             @default("UNKNOWN")
  size           String             @default("UNKNOWN")
  approximateAge String
  description    String
  photoUrl       String?
  status         String             @default("AVAILABLE")
  specialNeeds   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  interests      AdoptionInterest[]
  needs          AnimalNeed[]
  supports       SupportRecord[]

  @@index([status])
  @@index([species])
}

model Campaign {
  id              String          @id @default(uuid())
  title           String
  description     String
  goalAmountCents Int
  status          String          @default("ACTIVE")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supports        SupportRecord[]

  @@index([status])
}

model AnimalNeed {
  id                String          @id @default(uuid())
  animalId          String
  title             String
  description       String
  category          String
  targetAmountCents Int?
  status            String          @default("OPEN")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  animal            Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  supports          SupportRecord[]

  @@index([animalId])
  @@index([status])
}

model Donor {
  id        String          @id @default(uuid())
  name      String
  email     String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  supports  SupportRecord[]

  @@index([createdAt])
}

model SupportRecord {
  id           String      @id @default(uuid())
  donorId      String
  destination  String
  amountCents  Int
  frequency    String      @default("ONE_TIME")
  animalId     String?
  campaignId   String?
  animalNeedId String?
  message      String?
  status       String      @default("PLEDGED")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  donor        Donor       @relation(fields: [donorId], references: [id], onDelete: Restrict)
  animal       Animal?     @relation(fields: [animalId], references: [id], onDelete: SetNull)
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  animalNeed   AnimalNeed? @relation(fields: [animalNeedId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([destination])
  @@index([status])
  @@index([createdAt])
}

model AdoptionInterest {
  id            String   @id @default(uuid())
  animalId      String
  requesterName String
  contact       String
  message       String?
  status        String   @default("RECEIVED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([status])
  @@index([createdAt])
}
