generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnimalStatus {
  AVAILABLE
  IN_TREATMENT
  IN_ADOPTION_PROCESS
  ADOPTED
}

enum AnimalSpecies {
  DOG
  CAT
  OTHER
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

enum AdoptionInterestStatus {
  RECEIVED
  CONTACTED
  ARCHIVED
}

model Animal {
  id             String             @id @default(uuid())
  name           String
  species        AnimalSpecies
  sex            AnimalSex          @default(UNKNOWN)
  size           AnimalSize         @default(UNKNOWN)
  approximateAge String
  description    String
  photoUrl       String?
  status         AnimalStatus       @default(AVAILABLE)
  specialNeeds   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  interests      AdoptionInterest[]

  @@index([status])
  @@index([species])
}

model AdoptionInterest {
  id            String                 @id @default(uuid())
  animalId      String
  requesterName String
  contact       String
  message       String?
  status        AdoptionInterestStatus @default(RECEIVED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([status])
  @@index([createdAt])
}
