generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnimalStatus {
  AVAILABLE
  IN_TREATMENT
  IN_ADOPTION_PROCESS
  ADOPTED
}

enum AnimalSpecies {
  DOG
  CAT
  OTHER
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

enum AdoptionInterestStatus {
  RECEIVED
  CONTACTED
  ARCHIVED
}

enum SupportDestination {
  GENERAL
  CAMPAIGN
  SPONSORSHIP
  ANIMAL_NEED
}

enum SupportFrequency {
  ONE_TIME
  MONTHLY
}

enum SupportStatus {
  PLEDGED
  CONFIRMED
  CANCELLED
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AnimalNeedCategory {
  FOOD
  MEDICINE
  VETERINARY
  SUPPLIES
  OTHER
}

enum AnimalNeedStatus {
  OPEN
  FULFILLED
  ARCHIVED
}

model Animal {
  id             String             @id @default(uuid())
  name           String
  species        AnimalSpecies
  sex            AnimalSex          @default(UNKNOWN)
  size           AnimalSize         @default(UNKNOWN)
  approximateAge String
  description    String
  photoUrl       String?
  status         AnimalStatus       @default(AVAILABLE)
  specialNeeds   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  interests      AdoptionInterest[]
  needs          AnimalNeed[]
  supports       SupportRecord[]

  @@index([status])
  @@index([species])
}

model Campaign {
  id              String          @id @default(uuid())
  title           String
  description     String
  goalAmountCents Int
  status          CampaignStatus  @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supports        SupportRecord[]

  @@index([status])
}

model AnimalNeed {
  id                String             @id @default(uuid())
  animalId          String
  title             String
  description       String
  category          AnimalNeedCategory
  targetAmountCents Int?
  status            AnimalNeedStatus   @default(OPEN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  animal            Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  supports          SupportRecord[]

  @@index([animalId])
  @@index([status])
}

model Donor {
  id        String          @id @default(uuid())
  name      String
  email     String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  supports  SupportRecord[]

  @@index([createdAt])
}

model SupportRecord {
  id           String             @id @default(uuid())
  donorId      String
  destination  SupportDestination
  amountCents  Int
  frequency    SupportFrequency   @default(ONE_TIME)
  animalId     String?
  campaignId   String?
  animalNeedId String?
  message      String?
  status       SupportStatus      @default(PLEDGED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  donor        Donor              @relation(fields: [donorId], references: [id], onDelete: Restrict)
  animal       Animal?            @relation(fields: [animalId], references: [id], onDelete: SetNull)
  campaign     Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  animalNeed   AnimalNeed?        @relation(fields: [animalNeedId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([destination])
  @@index([status])
  @@index([createdAt])
}

model AdoptionInterest {
  id            String                 @id @default(uuid())
  animalId      String
  requesterName String
  contact       String
  message       String?
  status        AdoptionInterestStatus @default(RECEIVED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([status])
  @@index([createdAt])
}
